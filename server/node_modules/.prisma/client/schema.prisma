generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String   @unique
  phone          String   @unique
  gender         String // "male" | "female"
  passwordHash   String
  condition      String? // e.g. "anxiety", "depression", etc.
  specGenderPref String?  @default("any") // "any" | "male" | "female"
  role           String   @default("user") // "user" | "specialist" | "admin"
  isVerified     Boolean  @default(false)
  tokenVersion   Int      @default(0) // Incremented to revoke all active JWT sessions
  status         String   @default("active") // "active" | "inactive" | "suspended"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  specialist Specialist?
  bookings   Booking[]
  payments   Payment[]
}

model Specialist {
  id         String   @id @default(uuid())
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  title      String
  specialty  String // e.g. "قلق وتوتر", "اكتئاب", "علاقات أسرية"
  bio        String
  expYears   Int      @default(5)
  rating     Float    @default(4.9)
  price      Float    @default(250.0) // بالريال
  avatar     String
  gender     String   @default("any") // "male" | "female"
  isFeatured Boolean  @default(true)
  status     String   @default("active") // "active" | "inactive"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  sessionTime  String // e.g. "اليوم 05:00 م" or ISO
  condition    String?
  status       String     @default("pending") // "pending" | "scheduled" | "completed" | "cancelled"
  notes        String?
  meetingLink  String? // رابط الاجتماع (Google Meet / Zoom / PsyAI Room)
  confirmedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  payment Payment?
}

model Payment {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String   @default("SAR")
  status         String   @default("paid") // "pending" | "paid" | "failed" | "refunded"
  paymentMethod  String   @default("VISA_CARD") // "VISA_CARD" | "MASTERCARD" | "MADA"
  transactionRef String   @unique
  cardLast4      String?
  cardBrand      String?  @default("Visa")
  createdAt      DateTime @default(now())
}

model OtpToken {
  id             String    @id @default(uuid())
  phone          String    @unique
  codeHash       String
  expiresAt      DateTime
  attempts       Int       @default(0)
  phoneLockUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     String // e.g. "AUTH_LOGIN", "OTP_VERIFIED", "BOOKING_VIEWED"
  resourceId String?
  ipHash     String
  result     String // "SUCCESS" | "DENIED" | "FAILED"
  metadata   String? // Sanitized JSON string of non-sensitive operational metadata
  timestamp  DateTime @default(now())
}

model Service {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String
  icon        String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
}

model Company {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  phone          String
  employeesCount Int      @default(50)
  status         String   @default("active")
  createdAt      DateTime @default(now())
}

model Article {
  id           String   @id @default(uuid())
  title        String
  lead         String?
  content      String
  category     String   @default("الصحة النفسية")
  categorySlug String   @default("general")
  takeaways    String? // JSON array stored as text
  readTime     String   @default("5 دقائق قراءة")
  authorName   String
  authorTitle  String
  specialistId String?
  status       String   @default("published") // "published" | "draft"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
