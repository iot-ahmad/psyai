generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ── MODELS ────────────────────────────────────────────────────────────────────

model User {
  id                  String               @id @default(cuid())
  firstName           String               @map("first_name")
  lastName            String               @map("last_name")

  emailEncrypted      String               @map("email_encrypted")
  emailHash           String               @unique @map("email_hash")
  phoneEncrypted      String               @map("phone_encrypted")
  phoneHash           String               @unique @map("phone_hash")

  passwordHash        String               @map("password_hash")
  gender              String               // "male" | "female"

  conditionEncrypted  String?              @map("condition_encrypted")
  specGenderPref      String?              @default("any") @map("spec_gender_pref") // "any" | "male" | "female"

  role                String               @default("user")        // "user" | "specialist" | "admin"
  isVerified          Boolean              @default(false) @map("is_verified")
  tokenVersion        Int                  @default(0) @map("token_version")

  language            String?              @default("ar")
  status              String               @default("active")      // "active" | "inactive" | "suspended"
  googleId            String?              @unique @map("google_id")

  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")

  // Relations
  specialist          Specialist?
  bookings            Booking[]
  payments            Payment[]
  b2bRequests         B2bRequest[]         @relation("UserB2bRequests")
  reviewedB2bRequests B2bRequest[]        @relation("AdminReviewedB2bRequests")
  articleQuestions    ArticleQuestion[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@index([status])
  @@map("users")
}

model Specialist {
  id                String               @id @default(cuid())
  userId            String               @unique @map("user_id")
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String
  title             String
  specialty         String
  bio               String?
  avatar            String?
  avatarUrl         String?              @map("avatar_url")
  price             Float
  rating            Float?               @default(0.0)
  isFeatured        Boolean?             @default(false) @map("is_featured")
  licenseNumber     String?              @map("license_number")
  gender            String?              @default("male") // "male" | "female"
  expYears          Int?                 @map("exp_years")
  status            String               @default("active") // "active" | "inactive" | "suspended"
  isAvailable       Boolean              @default(true)   @map("is_available")

  createdAt         DateTime             @default(now()) @map("created_at")

  // Relations
  schedules         SpecialistSchedule[]
  bookings          Booking[]
  articles          Article[]
  answeredQuestions ArticleQuestion[]    @relation("SpecialistAnswers")

  @@index([isFeatured, rating])
  @@index([status])
  @@map("specialists")
}

model SpecialistSchedule {
  id           String     @id @default(cuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  day          String     // "Sunday".."Saturday"
  startTime    String     @map("start_time")   // "HH:MM"
  endTime      String     @map("end_time")     // "HH:MM"
  available    Boolean?   @default(true)

  @@map("specialist_schedule")
}

model Booking {
  id                 String            @id @default(cuid())
  userId             String            @map("user_id")
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  specialistId       String            @map("specialist_id")
  specialist         Specialist        @relation(fields: [specialistId], references: [id], onDelete: Restrict)

  sessionTime        DateTime          @map("session_time")
  status             String            @default("pending") // "pending" | "confirmed" | "completed" | "cancelled" | "no_show"
  meetingLink        String?           @map("meeting_link")
  notes              String?
  conditionEncrypted String?           @map("condition_encrypted")

  // CliQ payment verification
  cliqSenderName     String?           @map("cliq_sender_name")
  cliqRefNumber      String?           @map("cliq_ref_number")

  // Rating & Reviews
  rating             Float?
  reviewNotes        String?           @map("review_notes")
  reviewedAt         DateTime?         @map("reviewed_at")
  confirmedAt        DateTime?         @map("confirmed_at")

  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at")

  // Relations
  payment            Payment?
  reminders          SessionReminder[]

  @@unique([specialistId, sessionTime], name: "unique_booking_specialist_time")
  @@index([userId, createdAt])
  @@index([specialistId, sessionTime])
  @@map("bookings")
}

model Payment {
  id             String   @id @default(cuid())
  bookingId      String   @unique @map("booking_id")
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  amount         Float
  currency       String   @default("JOD")
  status         String   @default("PENDING") // "PENDING" | "SUCCEEDED" | "FAILED" | "REFUNDED"

  idempotencyKey String   @unique @map("idempotency_key")
  visaSessionId  String?  @unique @map("visa_session_id")
  transactionId  String?  @unique @map("transaction_id")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("payments")
}

model Article {
  id           String            @id @default(cuid())
  specialistId String            @map("specialist_id")
  specialist   Specialist        @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  title        String
  slug         String?           @unique
  categorySlug String            @map("category_slug")
  summary      String?
  content      String?
  body         String?
  coverImage   String?           @map("cover_image")
  status       String            @default("draft") // "draft" | "published" | "archived"

  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")

  // Relations
  questions    ArticleQuestion[]

  @@index([specialistId])
  @@index([status])
  @@map("articles")
}

model ArticleQuestion {
  id         String     @id @default(cuid())
  articleId  String     @map("article_id")
  article    Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId     String?    @map("user_id")
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  guestName  String?    @map("guest_name")
  question   String
  answer     String?

  answeredBy String?    @map("answered_by")
  specialist Specialist? @relation("SpecialistAnswers", fields: [answeredBy], references: [id], onDelete: SetNull)

  status     String     @default("pending") // "pending" | "published" | "rejected"
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([articleId, status])
  @@index([createdAt])
  @@map("article_questions")
}

model B2bRequest {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  user           User      @relation("UserB2bRequests", fields: [userId], references: [id], onDelete: Cascade)
  companyId      String?   @map("company_id")
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  companyName    String    @map("company_name")
  phone          String
  email          String
  employeesCount String    @map("employees_count")
  status         String    @default("pending") // "pending" | "approved" | "rejected"

  reviewedBy     String?   @map("reviewed_by")
  reviewer       User?     @relation("AdminReviewedB2bRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewNote     String?   @map("review_note")

  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([status])
  @@map("b2b_requests")
}

model SessionReminder {
  id           String    @id @default(cuid())
  bookingId    String    @map("booking_id")
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  reminderType String    @map("reminder_type") // "24h" | "1h" | "session_link"
  status       String    @default("pending")   // "pending" | "sent" | "failed"
  scheduledAt  DateTime  @map("scheduled_at")
  sentAt       DateTime? @map("sent_at")

  @@unique([bookingId, reminderType], name: "unique_booking_reminder")
  @@index([status, scheduledAt])
  @@map("session_reminders")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  details   String?  // JSON stored as text in SQLite

  createdAt DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model OtpToken {
  id             String    @id @default(cuid())
  phone          String    @unique
  codeHash       String    @map("code_hash")
  attempts       Int       @default(0)
  phoneLockUntil DateTime? @map("phone_lock_until")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_tokens")
}

model Company {
  id             String       @id @default(cuid())
  name           String
  email          String?      @unique
  phone          String?
  address        String?
  logo           String?
  employeesCount Int?         @default(50) @map("employees_count")
  status         String       @default("active")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  b2bRequests    B2bRequest[]

  @@index([status])
  @@map("companies")
}

model Service {
  id          String   @id @default(cuid())
  title       String   @default("")
  slug        String?  @unique
  description String?
  price       Float    @default(25.0)
  duration    Int      @default(60)
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("services")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}
