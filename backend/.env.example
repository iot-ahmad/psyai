# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ── WhatsApp OTP ──────────────────────────────────────────────────────────────
# Provider: "simulator" | "meta" | "twilio"
WHATSAPP_PROVIDER="simulator"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="psyai_otp_verification"

# ── Payment Gateway ───────────────────────────────────────────────────────────
# Provider: "simulator" | "visa" | "stripe" | "moyasar"
PAYMENT_GATEWAY="simulator"
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
VISA_WEBHOOK_SECRET=""
VISA_HOSTED_CHECKOUT_URL=""
VISA_API_KEY=""
VISA_MERCHANT_ID=""
VISA_SHARED_SECRET=""

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=""
