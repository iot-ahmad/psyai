# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psyai?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ── Data Encryption (AES-256-GCM & Blind Index) ──────────────────────────────
DB_ENCRYPTION_KEY="replace-with-a-32-byte-hex-or-base64-encryption-key"
BLIND_INDEX_PEPPER="replace-with-a-random-pepper-for-blind-indexing"

# ── WhatsApp OTP ──────────────────────────────────────────────────────────────
# Provider: "simulator" | "meta" | "twilio"
WHATSAPP_PROVIDER="simulator"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="psyai_otp_verification"

# ── Payment Gateway ───────────────────────────────────────────────────────────
# Provider: "simulator" | "visa" | "stripe" | "moyasar"
PAYMENT_GATEWAY="simulator"
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
VISA_WEBHOOK_SECRET=""
VISA_HOSTED_CHECKOUT_URL=""
VISA_API_KEY=""
VISA_MERCHANT_ID=""
VISA_SHARED_SECRET=""

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=""
